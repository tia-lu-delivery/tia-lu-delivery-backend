	"item": [
		{
			"name": "Cenários de Sucesso",
			"item": [
				{
					"name": "Fluxo de Validação - Comparação (Antes/Depois)",
					"item": [
						{
							"name": "Passo 1 - Listar Estado Inicial",
							"event": [
								{
									"listen": "test",
									"script": {
										"exec": [
											"pm.test(\"Status code é 200 OK\", function () {",
											"    pm.response.to.have.status(200);",
											"});",
											"",
											"var jsonData = pm.response.json();",
											"",
											"pm.test(\"Endereço 67890 deve estar marcado como principal (true)\", function () {",
											"    var item = jsonData.find(e => e.id === 67890);",
											"    pm.expect(item).to.exist;",
											"    pm.expect(item.padrao_entrega).to.be.true;",
											"});"
										],
										"type": "text/javascript",
										"packages": {},
										"requests": {}
									}
								}
							],
							"request": {
								"method": "GET",
								"header": [
									{
										"key": "UserId",
										"value": "{{userId}}",
										"type": "text"
									}
								],
								"url": {
									"raw": "{{baseUrl}}/api/v1/users/address",
									"host": [
										"{{baseUrl}}"
									],
									"path": [
										"api",
										"v1",
										"users",
										"address"
									]
								},
								"description": "Verifica o estado inicial do banco Mock."
							},
							"response": []
						},
