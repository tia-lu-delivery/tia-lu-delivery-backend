							"script": {
								"exec": [
									"pm.test(\"Status code é 200 OK\", function () {",
									"    pm.response.to.have.status(200);",
									"});",
									"",
									"var jsonData = pm.response.json();",
									"",
									"pm.test(\"ID principal voltou a ser 67890\", function () {",
									"    pm.expect(jsonData.id_endereco_principal).to.eql(67890);",
									"});"
