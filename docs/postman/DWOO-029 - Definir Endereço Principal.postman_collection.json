									"        pm.expect(address).to.have.property('padrao_entrega');",
									"    });",
									"});",
									"",
									"// Armazena estado inicial para validação posterior",
									"var principalAntes = jsonData.find(e => e.padrao_entrega === true);",
									"if (principalAntes) {",
									"    pm.globals.set('principal_antes', principalAntes.id.toString());",
									"}"
