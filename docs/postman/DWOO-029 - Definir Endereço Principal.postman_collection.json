		{
			"name": "Testes de Integração das 3 Tasks",
			"item": [
				{
					"name": "Fluxo Completo - Estado Inicial → Alteração → Validação",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"pm.test(\"Integração: Tasks #160, #161, #162 funcionando em conjunto\", function () {",
									"    pm.response.to.have.status(200);",
									"});",
									"",
									"var jsonData = pm.response.json();",
									"",
									"pm.test(\"Integração: Controller → Service → Repository → DTO\", function () {",
									"    pm.expect(jsonData).to.be.an('array');",
									"    ",
									"    // Verifica se há endereços",
									"    pm.expect(jsonData.length).to.be.greaterThan(0);",
