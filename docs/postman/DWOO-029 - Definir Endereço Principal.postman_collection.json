				{
					"name": "CA-004 - Validar Desmarcação Automática (Fluxo Completo)",
					"event": [
						{
							"listen": "prerequest",
							"script": {
								"exec": [
									"// Define endereço alvo baseado no estado atual",
									"var targetId = pm.globals.get('principal_antes') === '67890' ? '12345' : '67890';",
									"pm.globals.set('target_address', targetId);"
								],
								"type": "text/javascript"
							}
						},
						{
							"listen": "test",
							"script": {
								"exec": [
									"pm.test(\"Task #161: Query unsetAllPrincipalAddressesByUserId - Status 200\", function () {",
									"    pm.response.to.have.status(200);",
									"});",
									"",
									"// Executa request para validar resultado",
									"pm.sendRequest({",
									"    url: pm.globals.get('baseUrl') + '/api/v1/users/address',",
									"    method: 'GET',",
									"    header: {",
									"        'UserId': pm.globals.get('userId')",
									"    }",
									"}, function (err, response) {",
									"    var addresses = response.json();",
									"    var targetId = parseInt(pm.globals.get('target_address'));",
									"    var previousId = parseInt(pm.globals.get('principal_antes'));",
									"    ",
									"    pm.test(\"CA-004: Novo endereço marcado como principal (setPrincipalAddress)\", function () {",
									"        var novo = addresses.find(e => e.id === targetId);",
									"        pm.expect(novo.padrao_entrega).to.be.true;",
									"    });",
									"    ",
									"    pm.test(\"CA-004: Endereço anterior desmarcado (unsetAllPrincipalAddressesByUserId)\", function () {",
									"        var antigo = addresses.find(e => e.id === previousId);",
									"        if (antigo && antigo.id !== targetId) {",
									"            pm.expect(antigo.padrao_entrega).to.be.false;",
									"        }",
									"    });",
									"    ",
									"    pm.test(\"Task #161: Apenas um endereço é principal\", function () {",
									"        var principais = addresses.filter(e => e.padrao_entrega === true);",
									"        pm.expect(principais.length).to.eql(1);",
									"    });",
									"});"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "PATCH",
						"header": [
							{
								"key": "UserId",
								"value": "{{userId}}",
								"type": "text"
							}
						],
						"url": {
							"raw": "{{baseUrl}}/api/v1/users/address/{{target_address}}/set-principal",
							"host": [
								"{{baseUrl}}"
							],
							"path": [
								"api",
								"v1",
								"users",
								"address",
								"{{target_address}}",
								"set-principal"
							]
						},
						"description": "**Task #161**: Testa queries customizadas do Repository\n\n**Valida:**\n- CA-004: unsetAllPrincipalAddressesByUserId\n- CA-004: setPrincipalAddress\n- Transações funcionando corretamente"
					},
					"response": []
				}
			],
